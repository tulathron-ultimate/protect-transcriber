# ---------------------------------------------------------------------------
# UniFi Protect
# ---------------------------------------------------------------------------
# Host or IP of the UDM / Cloud Key / NVR. No scheme, no trailing slash.
PROTECT_HOST=192.168.1.1
PROTECT_PORT=443

# A LOCAL Protect account (Settings -> Admins -> Add Admin -> Local Access Only).
# Give it Live-only/View access to the cameras you care about. Do not enable 2FA
# on it -- the login API cannot satisfy a second factor.
# This is the mode that reliably drives clip export.
PROTECT_USERNAME=transcriber
PROTECT_PASSWORD=change-me

# Optional. A Protect API key (Settings -> Control Plane -> Integrations) is used
# for the newer integration endpoints. Export coverage varies by firmware, so keep
# the local account above as well.
PROTECT_API_KEY=

# UniFi ships a self-signed certificate, so verification is off by default.
PROTECT_VERIFY_SSL=false

# ---------------------------------------------------------------------------
# Whisper instances
# ---------------------------------------------------------------------------
# OPTIONAL. Whisper instances are managed in the web UI (sidebar -> Whisper ->
# Configure), where changes apply immediately without a restart. Whatever is set
# here is loaded ONCE on first start, so it appears in the UI ready to edit;
# after that the database is the source of truth and this value is ignored.
#
# Comma-separated: [name=]url[|kind][|model][|concurrency]
#   kind: auto (default) | openai | asr_webservice | whisper_cpp
#     openai         -> Speaches / faster-whisper-server (/v1/audio/transcriptions)
#     asr_webservice -> onerahmet/openai-whisper-asr-webservice (/asr)
#     whisper_cpp    -> whisper.cpp server (/inference)
#   concurrency: simultaneous requests this instance can handle (default 1)
#
# Example with both of the containers you are running:
WHISPER_INSTANCES=faster=http://192.168.1.50:8000|openai|Systran/faster-whisper-large-v3|2,asr=http://192.168.1.50:9000|asr_webservice
#
# A JSON array also works if you need api_key per instance:
# WHISPER_INSTANCES=[{"name":"gpu","url":"http://10.0.0.5:8000","kind":"openai","model":"large-v3","concurrency":2,"api_key":""}]

# Leave blank to let Whisper auto-detect the language.
WHISPER_LANGUAGE=
WHISPER_TASK=transcribe
WHISPER_VAD_FILTER=true
WHISPER_TIMEOUT=1800
WHISPER_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
# Long audio is split before transcription. Boundaries snap to a nearby silence
# so words are not cut in half.
CHUNK_SECONDS=300
CHUNK_OVERLAP_SECONDS=2
SILENCE_SNAP_WINDOW=15

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
DATA_DIR=/data
# Set a long random string to require a token. The UI then needs /?token=VALUE
# (it remembers it afterwards). Leave blank on a trusted LAN.
APP_TOKEN=
# Largest selectable range, in seconds (default 4 hours).
MAX_RANGE_SECONDS=14400
# Keep the exported mp4 so the UI can play it back next to the transcript.
KEEP_CLIPS=true
# Delete finished jobs and their files after this many days. 0 disables.
RETENTION_DAYS=30
# Jobs processed at once. Chunk-level parallelism already spreads across the
# pool, so 1 is usually right.
MAX_CONCURRENT_JOBS=1
LOG_LEVEL=INFO
